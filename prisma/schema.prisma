generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USER
model User {
  id       String @id @default(cuid())
  nama     String
  email    String @unique
  password String

  pesanan   Pesanan[]
  cartItems CartItem[]
}

// PRODUK
model Produk {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  tempat    String?
  harga     Int
  hargabeli Int?
  stok      Int      @default(0)
  fotoUrl   String?
  isAktif   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  varians     VarianProduk[]
  cartItems   CartItem[]
  detailItems DetailPesanan[]
  notas       nota[]
  itemDrafts  ItemDraft[]
}

// VARIAN PRODUK
model VarianProduk {
  id        String   @id @default(cuid())
  produkId  String
  nama      String
  harga     Int
  stok      Int      @default(0)
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produk      Produk          @relation(fields: [produkId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  detailItems DetailPesanan[]
  itemDrafts  ItemDraft[]
  notas       nota[]
}

// KERANJANG USER LAMA
model CartItem {
  id       String  @id @default(cuid())
  userId   String
  produkId String
  varianId String?
  jumlah   Int     @default(1)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  produk Produk        @relation(fields: [produkId], references: [id], onDelete: Cascade)
  varian VarianProduk? @relation(fields: [varianId], references: [id], onDelete: SetNull)
}

// PESANAN
model Pesanan {
  id          String   @id @default(cuid())
  userId      String?
  namaPembeli String
  total       Float
  createdAt   DateTime @default(now())

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  detailItems DetailPesanan[]
}

// DETAIL PESANAN
model DetailPesanan {
  id         String  @id @default(cuid())
  pesananId  String
  produkId   String
  varianId   String?
  namaVarian String?
  jumlah     Int
  harga      Int

  pesanan Pesanan       @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  produk  Produk        @relation(fields: [produkId], references: [id])
  varian  VarianProduk? @relation(fields: [varianId], references: [id], onDelete: SetNull)
}

// NOTA LAMA
model nota {
  id         String   @id @default(cuid())
  buyyer     String
  jumlahbeli Int
  tanggal    DateTime
  fotonota   String?
  produkId   String
  varianId   String?

  produk Produk        @relation(fields: [produkId], references: [id], onDelete: Cascade)
  varian VarianProduk? @relation(fields: [varianId], references: [id], onDelete: SetNull)
}

// DRAFT PESANAN
model DraftPesanan {
  id          String   @id @default(cuid())
  namaPembeli String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ItemDraft[]

  @@index([status])
  @@index([namaPembeli, status])
}

// ITEM DRAFT
model ItemDraft {
  id         String   @id @default(cuid())
  draftId    String
  produkId   String
  varianId   String?
  namaProduk String
  namaVarian String?
  harga      Int
  jumlah     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  draft  DraftPesanan  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  produk Produk        @relation(fields: [produkId], references: [id], onDelete: Restrict)
  varian VarianProduk? @relation(fields: [varianId], references: [id], onDelete: Restrict)

  @@index([draftId])
  @@index([draftId, produkId])
  @@index([produkId])
  @@index([varianId])
}

model SesiKasir {
  id          String    @id @default(cuid())
  modalAwal   Int
  uangAkhir   Int?
  totalJual   Int       @default(0)
  status      String    @default("BUKA")
  dibukaPada  DateTime  @default(now())
  ditutupPada DateTime?
}
